# Настройки контейнера ИИ-агентов для конкретного проекта. Это сторонний инструмент и не является частью приложения.

# Положите этот файл как .agents.env в корень проекта.
# Если файла нет — используется фолбэк из .env рядом с dev.sh.

# FWD_HOST_PORT — желаемый порт на хосте; если занят, возьмётся случайный свободный
FWD_HOST_PORT=8080
FWD_CONTAINER_PORT=80

# Имя проекта внутри контейнера (путь /var/www/<MOUNT_NAME>, имя контейнера agents-<MOUNT_NAME>).
# По умолчанию — имя директории хоста.
# Полезно для проектов с типовой структурой (app, src, backend).
# MOUNT_NAME=my-project

# Docker-outside-of-Docker: проброс Docker-сокета внутрь контейнера
# true (по умолчанию) — пробрасывать, false — не пробрасывать
# Переопределяет значение из .env
# ENABLE_DOCKER=true

# EXEC_BEFORE — команда, выполняемая на хосте перед запуском контейнера
# EXEC_AFTER  — команда, выполняемая на хосте после остановки контейнера
# EXEC_BEFORE="echo 'Starting...'"
# EXEC_AFTER="echo 'Stopped.'"
