{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    }
  },
  "lsp": {
    "laravel": {
      "command": [
        "laravel-ls"
      ],
      "extensions": [
        ".php"
      ]
    }
  }
}