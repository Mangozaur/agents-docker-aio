#!/bin/bash

set -e

# Get IP from environment variable (passed from host) or try to resolve it
CHROME_IP="${CHROME_DEBUG_HOST:-}"

if [ -z "$CHROME_IP" ]; then
  # Fallback: try to resolve via ping -4 (if available)
  if command -v ping &>/dev/null; then
    CHROME_IP=$(ping -4 -c 1 host.docker.internal 2>&1 | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -1)
  fi
fi

if [ -z "$CHROME_IP" ]; then
  # Fallback: parse /etc/hosts
  if [ -f /etc/hosts ]; then
    CHROME_IP=$(grep -w host.docker.internal /etc/hosts 2>/dev/null | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -1)
  fi
fi

if [ -z "$CHROME_IP" ]; then
  echo "ERROR: Could not determine IPv4 for host.docker.internal" >&2
  echo "Tip: Pass -e CHROME_DEBUG_HOST=<IPv4> when running the container" >&2
  exit 1
fi

echo "[chrome-mcp-wrapper] Using CHROME_DEBUG_HOST=$CHROME_IP" >&2
export CHROME_DEBUG_HOST="$CHROME_IP"
export CHROME_DEBUG_PORT="${CHROME_DEBUG_PORT:-9222}"
export NODE_OPTIONS="--dns-result-order=ipv4first"

exec npx -y chrome-devtools-mcp@latest \
    --no-launch \
    --browserUrl="http://$CHROME_IP:${CHROME_DEBUG_PORT:-9222}" \
    --no-performance-crux \
    --no-usage-statistics \
    "$@"