# При настройке прокси нужно помнить, что внутри контейнера локалхост это host.docker.internal
# Если вместо прокси планируется просто ходить через VPN, то нужно проставить пустые значения

# Claude поддерживает только http-прокси
CLAUDE_PROXY=http://
CODEX_PROXY=socks5://

# Хосты, которые нужно открывать в обход проксирования
# Через запятую, без пробелов, без кавычек
NO_PROXY=localhost,127.0.0.1,host.docker.internal

# Проброс портов — фолбэк, если в директории проекта нет .agents.env
# (FWD_HOST_PORT — желаемый; если занят, возьмётся случайный свободный)
FWD_HOST_PORT=8080
FWD_CONTAINER_PORT=80

# Docker-outside-of-Docker: проброс Docker-сокета внутрь контейнера
# true (по умолчанию) — пробрасывать, false — не пробрасывать
ENABLE_DOCKER=true